# Copia este archivo como .env y completa los valores de tu proyecto Supabase.
# Configuración exclusiva del servidor; no usar el prefijo VITE_.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_completa_tu_clave_publica
# Solo servidor: clave Secret del panel Supabase para administrar libros.
# No usar prefijo VITE_ ni pegar esta clave en Postman o en el navegador.
SUPABASE_SECRET_KEY=
PORT=3000

# Cuenta administrativa (contraseña de al menos 12 caracteres).
ADMIN_USUARIO=
ADMIN_CONTRASENA=

# Solo para npm run test:integracion: cuerpo existente y ya publicado.
CUERPO_PRUEBA_SLUG=
CUERPO_PRUEBA_ID=
